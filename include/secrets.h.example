// Gliderol2MQTT credentials.
//
// Copy this file to include/secrets.h and fill in your own values.  secrets.h is git-ignored, so your
// passwords never end up in the repository.  Any characters are fine inside the quotes; escape a double
// quote as \" and a backslash as \\.
//
// These are the compiled-in defaults.  A settings.txt on the SD card, if present, overrides them.

#pragma once

#define WIFI_SSID "YOUR_SSID"
#define WIFI_PASSWORD "YOUR_PASSWORD"

#define MQTT_BROKER "192.168.1.135"
#define MQTT_PORT 1883
#define MQTT_USERNAME "YOUR_MQTT_BROKER_USERNAME"
#define MQTT_PASSWORD "YOUR_MQTT_BROKER_PASSWORD"

// Password for over-the-air uploads.  Also read by scripts/ota_auth.py when uploading, so it lives only here.
// Letters and digits only (it is passed to the uploader on a command line).
#define OTA_PASSWORD "SomeLongRandomLettersAndDigits"
